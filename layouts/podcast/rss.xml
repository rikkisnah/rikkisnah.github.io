{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
{{- $pages := .Pages -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- $podcast := .Site.Params.podcast -}}
{{- $section := .Params -}}
<rss version="2.0"
     xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:googleplay="http://www.google.com/schemas/play-podcasts/1.0">
  <channel>
    <title>{{ $section.title | default $podcast.title | default .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $section.description | default $podcast.description | default .Site.Params.description }}</description>
    <language>{{ $section.language | default $podcast.language | default .Site.LanguageCode | default "en-us" }}</language>
    <copyright>Copyright {{ now.Year }} {{ $section.author | default $podcast.author | default .Site.Params.name }}</copyright>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <pubDate>{{ if $pages }}{{ (index $pages 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}{{ else }}{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}{{ end }}</pubDate>
    <atom:link href="{{ .Permalink }}feed.xml" rel="self" type="application/rss+xml"/>

    <!-- iTunes/Apple Podcasts -->
    <itunes:author>{{ $section.author | default $podcast.author | default .Site.Params.name }}</itunes:author>
    <itunes:summary>{{ $section.description | default $podcast.description | default .Site.Params.description }}</itunes:summary>
    <itunes:subtitle>{{ $section.description | default $podcast.description | default .Site.Params.description | truncate 150 }}</itunes:subtitle>
    <itunes:owner>
      <itunes:name>{{ $section.author | default $podcast.author | default .Site.Params.name }}</itunes:name>
      <itunes:email>{{ $section.email | default $podcast.email }}</itunes:email>
    </itunes:owner>
    <itunes:explicit>{{ $section.explicit | default $podcast.explicit | default "no" }}</itunes:explicit>
    <itunes:category text="{{ $section.category | default $podcast.category | default "Technology" }}">
      {{ if or $section.subcategory $podcast.subcategory }}<itunes:category text="{{ $section.subcategory | default $podcast.subcategory }}"/>{{ end }}
    </itunes:category>
    <itunes:image href="{{ ($section.cover | default $podcast.cover | default "/images/podcast/cover.png") | absURL }}"/>
    <itunes:type>episodic</itunes:type>

    <!-- Google Podcasts / YouTube Music -->
    <googleplay:author>{{ $section.author | default $podcast.author | default .Site.Params.name }}</googleplay:author>
    <googleplay:description>{{ $section.description | default $podcast.description | default .Site.Params.description }}</googleplay:description>
    <googleplay:email>{{ $section.email | default $podcast.email }}</googleplay:email>
    <googleplay:image href="{{ ($section.cover | default $podcast.cover | default "/images/podcast/cover.png") | absURL }}"/>
    <googleplay:category text="{{ $section.category | default $podcast.category | default "Technology" }}"/>
    <googleplay:explicit>{{ $section.explicit | default $podcast.explicit | default "no" }}</googleplay:explicit>

    <!-- Channel Image -->
    <image>
      <url>{{ ($section.cover | default $podcast.cover | default "/images/podcast/cover.png") | absURL }}</url>
      <title>{{ $section.title | default $podcast.title | default .Site.Title }}</title>
      <link>{{ .Permalink }}</link>
    </image>

    <!-- Episodes -->
    {{- range $pages }}
    {{- if .Params.audio }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Params.summary | default .Summary | plainify | htmlUnescape }}</description>
      <content:encoded>{{ printf "<![CDATA[%s]]>" .Content | safeHTML }}</content:encoded>

      <!-- Audio Enclosure -->
      <enclosure url="{{ .Params.audio }}" length="{{ .Params.length | default 0 }}" type="audio/mpeg"/>

      <!-- iTunes Episode Info -->
      <itunes:title>{{ .Title }}</itunes:title>
      <itunes:summary>{{ .Params.summary | default .Summary | plainify | htmlUnescape }}</itunes:summary>
      <itunes:duration>{{ .Params.duration | default "00:00:00" }}</itunes:duration>
      <itunes:explicit>{{ .Params.explicit | default $section.explicit | default $podcast.explicit | default "no" }}</itunes:explicit>
      <itunes:episodeType>full</itunes:episodeType>
      {{- if .Params.episode }}
      <itunes:episode>{{ .Params.episode }}</itunes:episode>
      {{- end }}
      {{- if .Params.season }}
      <itunes:season>{{ .Params.season }}</itunes:season>
      {{- end }}
      {{- if .Params.episodeImage }}
      <itunes:image href="{{ .Params.episodeImage | absURL }}"/>
      {{- end }}

      <!-- Google/YouTube -->
      <googleplay:description>{{ .Params.summary | default .Summary | plainify | htmlUnescape }}</googleplay:description>
      {{- if .Params.episodeImage }}
      <googleplay:image href="{{ .Params.episodeImage | absURL }}"/>
      {{- end }}
      {{- if .Params.youtube }}

      <!-- YouTube Video Link -->
      <comments>{{ .Params.youtube }}</comments>
      {{- end }}
    </item>
    {{- end }}
    {{- end }}
  </channel>
</rss>
