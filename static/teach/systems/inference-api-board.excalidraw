ize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "replace a dead GPU \u00b7 minutes to boot", "autoResize": true, "lineHeight": 1.25}, {"id": "cXeeWN3XnoF5lr0l2jLb", "type": "text", "x": 900, "y": 720, "width": 1036.75, "height": 16.25, "angle": 0, "strokeColor": "#b91c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0055", "roundness": null, "seed": 1188243161, "version": 1, "versionNonce": 1153450782, "isDeleted": false, "boundElements": [], "updated": 1790436097942, "created": 1790436097942, "link": null, "locked": false, "text": "Failure: a GPU dies mid-batch \u2192 the request\u2192batch map re-enqueues those requests at the head; the client's idempotency key stops a double answer.", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Failure: a GPU dies mid-batch \u2192 the request\u2192batch map re-enqueues those requests at the head; the client's idempotency key stops a double answer.", "autoResize": true, "lineHeight": 1.25}, {"id": "mMHO2X9o7BwC57XshmPR", "type": "text", "x": 420, "y": 800, "width": 52.800000000000004, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0056", "roundness": null, "seed": 281971863, "version": 1, "versionNonce": 995580139, "isDeleted": false, "boundElements": [], "updated": 1790436097942, "created": 1790436097942, "link": null, "locked": false, "text": "Legend", "fontSize": 16, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Legend", "autoResize": true, "lineHeight": 1.25}, {"id": "a9ucC