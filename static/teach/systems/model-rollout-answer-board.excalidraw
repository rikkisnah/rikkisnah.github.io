tSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "the service under design", "autoResize": true, "lineHeight": 1.25}, {"id": "XwzeU0jtrDCXbnPX9F0X", "type": "rectangle", "x": 880, "y": 950, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#dcfce7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "wn4yYqB0I7x7jvOAvVXv", "index": "a0063", "roundness": {"type": 3}, "seed": 1656341268, "version": 1, "versionNonce": 1603748023, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false}, {"id": "EEo98JCZzMCnPOw9qNbc", "type": "text", "x": 910, "y": 951, "width": 164.45000000000002, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "wn4yYqB0I7x7jvOAvVXv", "index": "a0064", "roundness": null, "seed": 1103370405, "version": 1, "versionNonce": 753721334, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "artifact store, records", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "artifact store, records", "autoResize": true, "lineHeight": 1.25}, {"id": "pRM4bAECTrWFSVwux1a2", "type": "rectangle", "x": 1110, "y": 950, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ede9fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "wn4yYqB0I7x7jvOAvVXv", "index": "a0065", "roundness": {"type": 3}, "seed": 72075923, "version": 1, "versionNonce": 574380918, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false}, {"id": "OZCHIJyaLBFwkPb0Bcqd", "type": "text", "x": 1140, "y": 951, "width": 114.4, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "wn4yYqB0I7x7jvOAvVXv", "index": "a0066", "roundness": null, "seed": 84232921, "version": 1, "versionNonce": 1552798996, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "regional staging", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "regional staging", "autoResize": true, "lineHeight": 1.25}, {"id": "Cpke2JMXlUTtLghysbx7", "type": "rectangle", "x": 1340, "y": 950, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fee2e2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "wn4yYqB0I7x7jvOAvVXv", "index": "a0067", "roundness": {"type": 3}, "seed": 2074249074, "version": 1, "versionNonce": 1904036709, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false}, {"id": "6FllGhdn9GjOmDDqBfoY", "type": "text", "x": 1370, "y": 951, "width": 143.0, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "wn4yYqB0I7x7jvOAvVXv", "index": "a0068", "roundness": null, "seed": 1267413361, "version": 1, "versionNonce": 1550281740, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "workers (data plane)", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "workers (data plane)", "autoResize": true, "lineHeight": 1.25}, {"id": "PYuilgrRbRPI5Ys7zNKq", "type": "rectangle", "x": 1570, "y": 950, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "wn4yYqB0I7x7jvOAvVXv", "index": "a0069", "roundness": {"type": 3}, "seed": 1958387594, "version": 1, "versionNonce": 1019997368, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false}, {"id": "9Edpe1BPNNI5WwG8shfb", "type": "text", "x": 1600, "y": 951, "width": 107.25000000000001, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "wn4yYqB0I7x7jvOAvVXv", "index": "a0070", "roundness": null, "seed": 1874836705, "version": 1, "versionNonce": 587361588, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "traffic routing", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "traffic routing", "autoResize": true, "lineHeight": 1.25}, {"id": "RLgn54jWA4WYENWaayb7", "type": "rectangle", "x": 1800, "y": 950, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fef9c3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "wn4yYqB0I7x7jvOAvVXv", "index": "a0071", "roundness": {"type": 3}, "seed": 1079200077, "version": 1, "versionNonce": 1870902147, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false}, {"id": "AbW24qEtLQW42ipo3wrh", "type": "text", "x": 1830, "y": 951, "width": 100.10000000000001, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "wn4yYqB0I7x7jvOAvVXv", "index": "a0072", "roundness": null, "seed": 916263200, "version": 1, "versionNonce": 1709972631, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "health, canary", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "health, canary", "autoResize": true, "lineHeight": 1.25}, {"id": "KfKKl3OGwex8qUtpxdMa", "type": "text", "x": -760, "y": -60, "width": 523.6, "height": 122.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0073", "roundness": null, "seed": 618785086, "version": 1, "versionNonce": 316112036, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "Questions to ask first\nWhat is a worker: host, process, or GPU? one loaded version per GPU?\nArtifact size, immutable, identified by version + checksum?\nOrigin outbound capacity and per-worker link? regions?\nMust the old version keep serving? rolling OK? spare capacity?\nWhat must be true before the first request hits V2?\nWhat does done mean: bytes on disk, ready, or serving capacity?", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Questions to ask first\nWhat is a worker: host, process, or GPU? one loaded version per GPU?\nArtifact size, immutable, identified by version + checksum?\nOrigin outbound capacity and per-worker link? regions?\nMust the old version keep serving? rolling OK? spare capacity?\nWhat must be true before the first request hits V2?\nWhat does done mean: bytes on disk, ready, or serving capacity?", "autoResize": true, "lineHeight": 1.25}, {"id": "a0FUIVafg2IrAzj6X4Q9", "type": "text", "x": -760, "y": 88.5, "width": 539.0, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0074", "roundness": null, "seed": 2062419746, "version": 1, "versionNonce": 1611862156, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "Requirements\nFR: publish a version; every worker ends with a verified copy;\nservice stays available; engineer sees progress, pauses, rolls back\nTC: origin link is the bottleneck; verify before serving;\nreadiness = exact version; capacity-safe cohorts; canary stop signals;\nresumable, idempotent, generation-checked reports", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Requirements\nFR: publish a version; every worker ends with a verified copy;\nservice stays available; engineer sees progress, pauses, rolls back\nTC: origin link is the bottleneck; verify before serving;\nreadiness = exact version; capacity-safe cohorts; canary stop signals;\nresumable, idempotent, generation-checked reports", "autoResize": true, "lineHeight": 1.25}, {"id": "hbtKe5SSucvVx8Yyb2KK", "type": "text", "x": -760, "y": 219.5, "width": 608.3000000000001, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0075", "roundness": null, "seed": 721460078, "version": 1, "versionNonce": 1358483693, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "Core entities\nArtifact(version, size, location, chunk hashes, checksum)\nRollout(id, target group, desired version, generation, status, cohort size)\nWorker(id, region, attempt/generation, actual version, state, heartbeat, error)\nstate: idle \u2192 downloading \u2192 verified \u2192 draining \u2192 loading \u2192 ready \u2192 serving", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Core entities\nArtifact(version, size, location, chunk hashes, checksum)\nRollout(id, target group, desired version, generation, status, cohort size)\nWorker(id, region, attempt/generation, actual version, state, heartbeat, error)\nstate: idle \u2192 downloading \u2192 verified \u2192 draining \u2192 loading \u2192 ready \u2192 serving", "autoResize": true, "lineHeight": 1.25}, {"id": "oe1Lm4atAQFCZrPtP2Mx", "type": "text", "x": -760, "y": 333.0, "width": 677.6, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0076", "roundness": null, "seed": 2111923663, "version": 1, "versionNonce": 1463012734, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "API\nPOST /releases {version, checksum} \u00b7 POST /rollouts {version, targets, cohort%, canary%}\nPOST /rollouts/{id}/pause \u00b7 /resume \u00b7 /rollback \u2192 new generation\nPOST /workers/{id}/report {generation, state, version, bytes, error}\nGET  /rollouts/{id} \u2192 downloaded / verified / ready / serving counts by region", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "API\nPOST /releases {version, checksum} \u00b7 POST /rollouts {version, targets, cohort%, canary%}\nPOST /rollouts/{id}/pause \u00b7 /resume \u00b7 /rollback \u2192 new generation\nPOST /workers/{id}/report {generation, state, version, bytes, error}\nGET  /rollouts/{id} \u2192 downloaded / verified / ready / serving counts by region", "autoResize": true, "lineHeight": 1.25}, {"id": "9f8AohyHBWNcrzmG4Osp", "type": "text", "x": -760, "y": 446.5, "width": 592.9000000000001, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0077", "roundness": null, "seed": 739014041, "version": 1, "versionNonce": 671315452, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "Data flow\npublish \u2192 controller assigns generation \u2192 origin serves one copy per region \u2192\nregional fan-out (cache tree or peer swarm, chunk hashes) \u2192 agent verifies \u2192\ncontroller drains a cohort \u2192 load + warm-up \u2192 ready(V2, gen) \u2192 router flips \u2192\nnext cohort; canary signals can pause; rollback = new generation to V1", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Data flow\npublish \u2192 controller assigns generation \u2192 origin serves one copy per region \u2192\nregional fan-out (cache tree or peer swarm, chunk hashes) \u2192 agent verifies \u2192\ncontroller drains a cohort \u2192 load + warm-up \u2192 ready(V2, gen) \u2192 router flips \u2192\nnext cohort; canary signals can pause; rollback = new generation to V1", "autoResize": true, "lineHeight": 1.25}, {"id": "TBbPIuQkvtYYtKXEDpNu", "type": "text", "x": -760, "y": 560.0, "width": 569.8000000000001, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0078", "roundness": null, "seed": 862782767, "version": 1, "versionNonce": 150287005, "isDeleted": false, "boundElements": [], "updated": 1790527769390, "created": 1790527769390, "link": null, "locked": false, "text": "What breaks first\nServing unverified bytes \u00b7 'downloaded' treated as 'ready' \u00b7\nstale completion activating the wrong version \u00b7 rollback assumed instant \u00b7\n'add a CDN' with no numbers \u00b7 all 1,000 pulling from the origin", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What breaks first\nServing unverified bytes \u00b7 'downloaded' treated as 'ready' \u00b7\nstale completion activating the wrong version \u00b7 rollback assumed instant \u00b7\n'add a CDN' with no numbers \u00b7 all 1,000 pulling from the origin", "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}