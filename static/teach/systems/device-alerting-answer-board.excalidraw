: 1331, "width": 92.95, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0088", "roundness": null, "seed": 1999010143, "version": 1, "versionNonce": 1551894658, "isDeleted": false, "boundElements": [], "updated": 1790890881340, "created": 1790890881340, "link": null, "locked": false, "text": "alert service", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "alert service", "autoResize": true, "lineHeight": 1.25}, {"id": "JJPcXcaLaUxH3OVnAxnB", "type": "rectangle", "x": 1340, "y": 1330, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#dcfce7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0089", "roundness": {"type": 3}, "seed": 1543576375, "version": 1, "versionNonce": 262207109, "isDeleted": false, "boundElements": [], "updated": 1790890881340, "created": 1790890881340, "link": null, "locked": false}, {"id": "xbFxp1Qo1Xdfe4SIN8Fc", "type": "text", "x": 1370, "y": 1331, "width": 50.050000000000004, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0090", "roundness": null, "seed": 882782111, "version": 1, "versionNonce": 68789262, "isDeleted": false, "boundElements": [], "updated": 1790890881340, "created": 1790890881340, "link": null, "locked": false, "text": "storage", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "storage", "autoResize": true, "lineHeight": 1.25}, {"id": "pLqNdVikVagL0aiLsXtr", "type": "rectangle", "x": 1570, "y": 1330, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fee2e2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0091", "roundness": {"type": 3}, "seed": 720316120, "version": 1, "versionNonce": 119872258, "isDeleted": false, "boundElements": [], "updated": 1790890881340, "created": 1790890881340, "link": null, "locked": false}, {"id": "8gxv1kxRohMdzfNUKgQb", "type": "text", "x": 1600, "y": 1331, "width": 107.25000000000001, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0092", "roundness": null, "seed": 631761012, "version": 1, "versionNonce": 526504375, "isDeleted": false, "boundElements": [], "updated": 1790890881340, "created": 1790890881340, "link": null, "locked": false, "text": "channel senders", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "channel senders", "autoResize": true, "lineHeight": 1.25}, {"id": "cq3xskVplRSrWPC5OebS", "type": "text", "x": 420, "y": 1390, "width": 792.0000000000001, "height": 112.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0093", "roundness": null, "seed": 462624005, "version": 1, "versionNonce": 806069330, "isDeleted": false, "boundElements": [], "updated": 1790890881340, "created": 1790890881340, "link": null, "locked": false, "text": "NUMBERS TO SAY OUT LOUD\n10,000 devices x 1 sample/s = 10,000 samples/s.  128 numbers x 8 B = ~1 KB a sample.\n10,000 x 1 KB = 10 MB/s  ->  ~860 GB a day raw  (not 100 MB: do the multiplication).\n6 h offline = 21,600 samples = ~22 MB per device.  Drain at 100x real time = ~4 min.\nRule evaluation: 10k samples/s x R rules, in memory, per device; trivial for one consumer group.\nLatency budget: seconds; a person takes ~30 s to look at a phone. Availability over consistency.", "fontSize": 15, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "NUMBERS TO SAY OUT LOUD\n10,000 devices x 1 sample/s = 10,000 samples/s.  128 numbers x 8 B = ~1 KB a sample.\n10,000 x 1 KB = 10 MB/s  ->  ~860 GB a day raw  (not 100 MB: do the multiplication).\n6 h offline = 21,600 samples = ~22 MB per device.  Drain at 100x real time = ~4 min.\nRule evaluation: 10k samples/s x R rules, in memory, per device; trivial for one consumer group.\nLatency budget: seconds; a person takes ~30 s to look at a phone. Availability over consistency.", "autoResize": true, "lineHeight": 1.25}, {"id": "1hjrMQ5qclk0zzF3gxmo", "type": "text", "x": 420, "y": 1580, "width": 825.0000000000001, "height": 112.5, "angle": 0, "strokeColor": "#b23a28", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0094", "roundness": null, "seed": 442057973, "version": 1, "versionNonce": 126361897, "isDeleted": false, "boundElements": [], "updated": 1790890881340, "created": 1790890881340, "link": null, "locked": false, "text": "RED: what fails and what you say\nLate data: evaluate on event time, mark the alert LATE; never page as if it were happening now.\nDuplicates: idempotent on (device_id, seq); alerts deduped on (rule, device, window).\nA channel is down: its queue grows, retries back off, DLQ after N; the other channels are untouched.\nFlapping: fire once, resolve once (hysteresis); severity decides SMS versus Slack.\nTimestamps in UTC end to end. Tyler's 2 a.m. false page was a daylight-saving bug.", "fontSize": 15, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "RED: what fails and what you say\nLate data: evaluate on event time, mark the alert LATE; never page as if it were happening now.\nDuplicates: idempotent on (device_id, seq); alerts deduped on (rule, device, window).\nA channel is down: its queue grows, retries back off, DLQ after N; the other channels are untouched.\nFlapping: fire once, resolve once (hysteresis); severity decides SMS versus Slack.\nTimestamps in UTC end to end. Tyler's 2 a.m. false page was a daylight-saving bug.", "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}