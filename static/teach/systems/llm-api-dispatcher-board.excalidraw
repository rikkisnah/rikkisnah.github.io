startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "T6cRoOli0ONApd6XUeaC", "type": "text", "x": 1700, "y": 578, "width": 235.95000000000002, "height": 16.25, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "b8UncNEuydUUbPJHgJFN", "index": "a0044", "roundness": null, "seed": 432396344, "version": 1, "versionNonce": 778975220, "isDeleted": false, "boundElements": [], "updated": 1790744794875, "created": 1790744794875, "link": null, "locked": false, "text": "ACK / busy error \u2192 free-slot list", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ACK / busy error \u2192 free-slot list", "autoResize": true, "lineHeight": 1.25}, {"id": "MtWkEzoulsByO2FmFj0a", "type": "arrow", "x": 1090.0, "y": 690, "width": 1, "height": 340, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "b8UncNEuydUUbPJHgJFN", "index": "a0045", "roundness": null, "seed": 1212732624, "version": 1, "versionNonce": 1038197647, "isDeleted": false, "boundElements": [], "updated": 1790744794875, "created": 1790744794875, "link": null, "locked": false, "points": [[0, 0], [0.0, -340]], "startBinding": {"elementId": "hOLrc6RMg3yCIB7CQV5k", "mode": "orbit", "fixedPoint": [0.5, 0]}, "endBinding": {"elementId": "rqr3pt38oiNV0PRb4EsD", "mode": "orbit", "fixedPoint": [0.5, 1]}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "vclZeRkUhim6bD4PaPtn", "type": "text", "x": 1102.0, "y": 390, "width": 300.3, "height": 16.25, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "b8UncNEuydUUbPJHgJFN", "index": "a0046", "roundness": null, "seed": 575812617, "version": 1, "versionNonce": 308293153, "isDeleted": false, "boundElements": [], "updated": 1790744794875, "created": 1790744794875, "link": null, "locked": false, "text": "depth \u2192 tighten admission, shed free first", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "depth \u2192 tighten admission, shed free first", "autoResize": true, "lineHeight": 1.25}, {"id": "hIU3NB4k58HUMRQQPElu", "type": "text", "x": 420, "y": 840, "width": 2040.5000000000002, "height": 35.0, "angle": 0, "strokeColor": "#b91c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "b8UncNEuydUUbPJHgJFN", "index": "a0047", "roundness": null, "seed": 1402338300, "version": 1, "versionNonce": 2128115451, "isDeleted": false, "boundElements": [], "updated": 1790744794875, "created": 1790744794875, "link": null, "locked": false, "text": "Failure / probes: high load \u2192 a partial batch wastes 100 ms of a server you cannot replace, hold until 100. Low load \u2192 waiting for 100 breaks the SLA, flush at ~50 ms. 40k in, 20k out \u2192 queue would grow 20k/s: bound it by deadline, 429 at the door, free tier first.\nServer errors when busy \u2192 no free slot, not an exception; stays errored \u2192 unhealthy, re-dispatch its batch from the map if the deadline allows. Never shard a prompt: a string is one request.", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Failure / probes: high load \u2192 a partial batch wastes 100 ms of a server you cannot replace, hold until 100. Low load \u2192 waiting for 100 breaks the SLA, flush at ~50 ms. 40k in, 20k out \u2192 queue would grow 20k/s: bound it by deadline, 429 at the door, free tier first.\nServer errors when busy \u2192 no free slot, not an exception; stays errored \u2192 unhealthy, re-dispatch its batch from the map if the deadline allows. Never shard a prompt: a string is one request.", "autoResize": true, "lineHeight": 1.25}, {"id": "iQD5AUii0YpAVfQR69Wh", "type": "text", "x": 420, "y": 905, "width": 2325.4, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "b8UncNEuydUUbPJHgJFN", "index": "a0048", "roundness": null, "seed": 689087843, "version": 1, "versionNonce": 2041282885, "isDeleted": false, "boundElements": [], "updated": 1790744794875, "created": 1790744794875, "link": null, "locked": false, "text": "Numbers to say: 100 strings / 0.1 s = 1,000 req/s per server \u00b7 20k req/s \u2192 20 servers floor, ~26\u201328 with fill loss and failures \u00b7 budget 500 ms = ~50 batch wait + 100 GPU + queueing/network + reserve for one retry \u00b7 flush timer ~50 ms \u00b7 a batch of 2 at low load costs the same 100 ms as a batch of 100.", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Numbers to say: 100 strings / 0.1 s = 1,000 req/s per server \u00b7 20k req/s \u2192 20 servers floor, ~26\u201328 with fill loss and failures \u00b7 budget 500 ms = ~50 batch wait + 100 GPU + queueing/network + reserve for one retry \u00b7 flush timer ~50 ms \u00b7 a batch of 2 at low load costs the same 100 ms as a batch of 100.", "autoResize": true, "lineHeight": 1.25}, {"id": "rYEA20sZ9QnHIrUhk6uj", "type": "text", "x": 420, "y": 955, "width": 2433.2000000000003, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "b8UncNEuydUUbPJHgJFN", "index": "a0049", "roundness": null, "seed": 1834590120, "version": 1, "versionNonce": 475850088, "isDeleted": false, "boundElements": [], "updated": 1790744794875, "created": 1790744794875, "link": null, "locked": false, "text": "Paul's follow-up: group by estimated duration so the shortest in a batch is within 15% of the longest (buckets 1\u20131.15 s, \u20131.32 s, \u2026); one queue per bucket; batch within a bucket only; reserve capacity for long buckets; estimate from string length or history, re-bucket on the fly. Bin packing by time, not by memory.", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Paul's follow-up: group by estimated duration so the shortest in a batch is within 15% of the longest (buckets 1\u20131.15 s, \u20131.32 s, \u2026); one queue per bucket; batch within a bucket only; reserve capacity for long buckets; estimate from string length or history, re-bucket on the fly. Bin packing by time, not by memory.", "autoResize": true, "lineHeight": 1.25}, {"id": "BEaa46SQzsTWfheRDeF6", "type": "text", "x": 420, "y": 1005, "width": 52.800000000000004, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "b8UncNEuydUUbPJHgJFN", "index": "a0050", "roundness": null, "seed": 15149645, "version": 1, "versionNonce": 848625085, "isDeleted": false, "boundElements": [], "updated": 1790744794875, "created": 1790744794875, "link": null, "locked": false, "text": "Legend", "fontSize": 16, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Legend", "autoResize": true, "lineHeight": 1.25}, {"id": "PkD9h91RjCL0Ddbr6uBm", "type": "rectangle", "x": 420, "y": 1035, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#f3f4f6", 