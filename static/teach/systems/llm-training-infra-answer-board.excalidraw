ness": null, "seed": 2147380350, "version": 1, "versionNonce": 1489723359, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false, "text": "storage", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "storage", "autoResize": true, "lineHeight": 1.25}, {"id": "HHExWS8tdyR5KaxHHwdy", "type": "rectangle", "x": 1340, "y": 1150, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fef9c3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0078", "roundness": {"type": 3}, "seed": 1114722375, "version": 1, "versionNonce": 1378653572, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false}, {"id": "DKlllRwIyGjc9xgNWjLv", "type": "text", "x": 1370, "y": 1151, "width": 150.15, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0079", "roundness": null, "seed": 88347952, "version": 1, "versionNonce": 404091006, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false, "text": "queue / observability", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "queue / observability", "autoResize": true, "lineHeight": 1.25}, {"id": "c91EJqWA6VY7pcmlfdI1", "type": "rectangle", "x": 1570, "y": 1150, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fee2e2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0080", "roundness": {"type": 3}, "seed": 1968301625, "version": 1, "versionNonce": 2090942405, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false}, {"id": "64dLyh7pIN7PyBj79ncp", "type": "text", "x": 1600, "y": 1151, "width": 71.5, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0081", "roundness": null, "seed": 1511875402, "version": 1, "versionNonce": 254591815, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false, "text": "node pools", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "node pools", "autoResize": true, "lineHeight": 1.25}, {"id": "34ZcWRO9diU6PsKUguph", "type": "text", "x": 420, "y": 1210, "width": 783.7500000000001, "height": 168.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0082", "roundness": null, "seed": 2067224217, "version": 1, "versionNonce": 1630567430, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false, "text": "NUMBERS TO SAY OUT LOUD\n20,000 GPUs / 8 per node = 2,500 nodes.   A job is 64 to 4,096 GPUs.\n4,000-GPU job = 500 nodes; node MTBF 6 months -> a failure every ~9 hours.\n100B params x 16 bytes (weights + optimizer moments) = ~1.6 TB of state;\n   sharded 4,000 ways = ~400 MB per rank; VRAM -> NVMe at 5 GB/s is <1 s.\n   The BARRIER is the cost, not the bytes. The upload is off the critical path.\nCheckpoint overhead: 60 s every 20 min = 5% of the fleet. Epoch-aligned (~1 h) < 2%.\nExpected lost work on a crash = half the checkpoint interval.\nMetric that exposes everything: GOODPUT = GPU-hours that committed steps / GPU-hours allocated.", "fontSize": 15, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "NUMBERS TO SAY OUT LOUD\n20,000 GPUs / 8 per node = 2,500 nodes.   A job is 64 to 4,096 GPUs.\n4,000-GPU job = 500 nodes; node MTBF 6 months -> a failure every ~9 hours.\n100B params x 16 bytes (weights + optimizer moments) = ~1.6 TB of state;\n   sharded 4,000 ways = ~400 MB per rank; VRAM -> NVMe at 5 GB/s is <1 s.\n   The BARRIER is the cost, not the bytes. The upload is off the critical path.\nCheckpoint overhead: 60 s every 20 min = 5% of the fleet. Epoch-aligned (~1 h) < 2%.\nExpected lost work on a crash = half the checkpoint interval.\nMetric that exposes everything: GOODPUT = GPU-hours that committed steps / GPU-hours allocated.", "autoResize": true, "lineHeight": 1.25}, {"id": "koiQaSmc5n513iBg50MC", "type": "text", "x": 420, "y": 1430, "width": 866.2500000000001, "height": 93.75, "angle": 0, "strokeColor": "#b23a28", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0083", "roundness": null, "seed": 1459340018, "version": 1, "versionNonce": 1385408520, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false, "text": "RED: what fails and what you say\nFail-stop (GPU off the bus, ECC, link down): agent detects, drain, swap a spare, restart from checkpoint.\nFail-slow (straggler): detect by step-time outlier; one slow rank slows all 4,000.\nSilent corruption: per-rank gradient-norm outlier + shadow recompute; answer was_it_hardware(job, steps).\nCheckpoint on EPOCH boundaries, not a timer: researchers compare quality per epoch and restart from one.", "fontSize": 15, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "RED: what fails and what you say\nFail-stop (GPU off the bus, ECC, link down): agent detects, drain, swap a spare, restart from checkpoint.\nFail-slow (straggler): detect by step-time outlier; one slow rank slows all 4,000.\nSilent corruption: per-rank gradient-norm outlier + shadow recompute; answer was_it_hardware(job, steps).\nCheckpoint on EPOCH boundaries, not a timer: researchers compare quality per epoch and restart from one.", "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}