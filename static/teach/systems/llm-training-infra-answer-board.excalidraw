ijF2WLWjiMhd", "type": "text", "x": 1390, "y": 53.875, "width": 280, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0012", "roundness": null, "seed": 2072265938, "version": 1, "versionNonce": 455736474, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false, "text": "Job service\n+ quota service\nadmit or reject by team", "fontSize": 15, "baseFontSize": null, "fontFamily": 5, "textAlign": "center", "verticalAlign": "middle", "containerId": "LKD6jHbXTgUi9m2bnFVu", "originalText": "Job service\n+ quota service\nadmit or reject by team", "autoResize": true, "lineHeight": 1.25}, {"id": "2dlcgCb3du8LmrFYFpG2", "type": "rectangle", "x": 1860, "y": 40, "width": 300, "height": 110, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fef9c3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0013", "roundness": {"type": 3}, "seed": 1114940396, "version": 1, "versionNonce": 870111104, "isDeleted": false, "boundElements": [{"type": "text", "id": "0ihBeoePW3jSOi27n7yE"}, {"type": "arrow", "id": "ZaM2AdPxF8LQclqawu9u"}, {"type": "arrow", "id": "6maTpey1e5U0rdPNj8Bt"}], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false}, {"id": "0ihBeoePW3jSOi27n7yE", "type": "text", "x": 1870, "y": 60.0, "width": 280, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0014", "roundness": null, "seed": 960836460, "version": 1, "versionNonce": 693491441, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false, "text": "Priority queue\nabsorbs bursts;\nages so big jobs\nnever starve", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "center", "verticalAlign": "middle", "containerId": "2dlcgCb3du8LmrFYFpG2", "originalText": "Priority queue\nabsorbs bursts;\nages so big jobs\nnever starve", "autoResize": true, "lineHeight": 1.25}, {"id": "R9zAwfwuCRxGs7g4o2fq", "type": "arrow", "x": 660, "y": 82.0, "width": 240, "height": 1, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0015", "roundness": null, "seed": 779757290, "version": 1, "versionNonce": 1161557138, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false, "points": [[0, 0], [240, 0.0]], "startBinding": {"elementId": "LgJH6MemxN7LDhE8DtiU", "mode": "orbit", "fixedPoint": [1, 0.5]}, "endBinding": {"elementId": "YToGwbbrqQ7B697wnomm", "mode": "orbit", "fixedPoint": [0, 0.5]}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "UY0P6zHFEurXl3qbfqLn", "type": "text", "x": 680, "y": 56.0, "width": 85.80000000000001, "height": 16.25, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0016", "roundness": null, "seed": 1135808359, "version": 1, "versionNonce": 522601131, "isDeleted": false, "boundElements": [], "updated": 1790867244655, "created": 1790867244655, "link": null, "locked": false, "text": "1 POST /jobs", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1 POST /jobs", "autoResize": true, "lineHeight": 1.25}, {"id": "CvI5qiGogkdmtsVrFlvb", "type": "arrow", "x": 1140, "y": 82.0,