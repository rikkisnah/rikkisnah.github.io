d": "cfvIBOFO4VjiCkzgCpzZ", "mode": "orbit", "fixedPoint": [1, 0.5]}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "dezuFFIpYs8sMwBAkwuE", "type": "text", "x": 1640, "y": 656, "width": 157.3, "height": 16.25, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0065", "roundness": null, "seed": 110600682, "version": 1, "versionNonce": 780277446, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false, "text": "load weights on demand", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "load weights on demand", "autoResize": true, "lineHeight": 1.25}, {"id": "ZP4kkuKlm5dAFJGzuW3t", "type": "text", "x": 900, "y": 780, "width": 1458.6000000000001, "height": 48.75, "angle": 0, "strokeColor": "#b91c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0066", "roundness": null, "seed": 2070209849, "version": 1, "versionNonce": 69636070, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false, "text": "Failure: a replica dies mid-batch \u2192 the request\u2192batch map re-enqueues those requests at the head of another replica's queue; the client's idempotency key prevents a double answer.\nCold start: a request for a model with no live replica \u2192 scheduler takes warm hardware (up, empty), streams weights from the weights store (~1 TB, minutes), marks the replica ready, router starts sending.\nKeep hardware warm, never the weights of unused models: pinned idle weights block another model from those GPUs.", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Failure: a replica dies mid-batch \u2192 the request\u2192batch map re-enqueues those requests at the head of another replica's queue; the client's idempotency key prevents a double answer.\nCold start: a request for a model with no live replica \u2192 scheduler takes warm hardware (up, empty), streams weights from the weights store (~1 TB, minutes), marks the replica ready, router starts sending.\nKeep hardware warm, never the weights of unused models: pinned idle weights block another model from those GPUs.", "autoResize": true, "lineHeight": 1.25}, {"id": "ztJGIIP5nQyXLzyMPHbu", "type": "text", "x": 420, "y": 900, "width": 52.800000000000004, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0067", "roundness": null, "seed": 2113479152, "version": 1, "versionNonce": 1565864877, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false, "text": "Legend", "fontSize": 16, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Legend", "autoResize": true, "lineHeight": 1.25}, {"id": "3WX7Lr8LjxcCts0VtkgL", "type": "rectangle", "x": 420, "y": 930, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#f3f4f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0068", "roundness": {"type": 3}, "seed": 137986159, "version": 1, "versionNonce": 106640302, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false}, {"id"