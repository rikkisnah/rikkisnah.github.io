front door", "autoResize": true, "lineHeight": 1.25}, {"id": "ce7upIXO9jAgMfSv5VQw", "type": "rectangle", "x": 880, "y": 930, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffedd5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0072", "roundness": {"type": 3}, "seed": 786221928, "version": 1, "versionNonce": 729212370, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false}, {"id": "pIyazWODmKOCIRDnmLVv", "type": "text", "x": 910, "y": 931, "width": 171.60000000000002, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0073", "roundness": null, "seed": 202637284, "version": 1, "versionNonce": 614814520, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false, "text": "the service under design", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "the service under design", "autoResize": true, "lineHeight": 1.25}, {"id": "jlLVEprzwY9rJfP5AFD8", "type": "rectangle", "x": 1110, "y": 930, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fee2e2", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0074", "roundness": {"type": 3}, "seed": 649511027, "version": 1, "versionNonce": 856647729, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false}, {"id": "OyJq7ya5xRh6NElO4NrO", "type": "text", "x": 1140, "y": 931, "width": 171.60000000000002, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0075", "roundness": null, "seed": 58176518, "version": 1, "versionNonce": 1688675063, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false, "text": "replicas: GPUs + weights", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "replicas: GPUs + weights", "autoResize": true, "lineHeight": 1.25}, {"id": "sVtrWV0WXGse1NZNs7LX", "type": "rectangle", "x": 1340, "y": 930, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#dcfce7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0076", "roundness": {"type": 3}, "seed": 514109624, "version": 1, "versionNonce": 2057866541, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false}, {"id": "XomA7N11kJ6z0BJk27Zm", "type": "text", "x": 1370, "y": 931, "width": 185.9, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0077", "roundness": null, "seed": 1719644660, "version": 1, "versionNonce": 43981234, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false, "text": "storage, registry, metrics", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "storage, registry, metrics", "autoResize": true, "lineHeight": 1.25}, {"id": "IgSoL0il4WsekrG3YQuj", "type": "rectangle", "x": 1570, "y": 930, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ede9fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0078", "roundness": {"type": 3}, "seed": 1348877894, "version": 1, "versionNonce": 1157677239, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false}, {"id": "25AVlIAOoXwdLoaeuPjv", "type": "text", "x": 1600, "y": 931, "width": 92.95, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0079", "roundness": null, "seed": 259568492, "version": 1, "versionNonce": 1075982659, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false, "text": "control plane", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "control plane", "autoResize": true, "lineHeight": 1.25}, {"id": "wcoN8zDnlj0EP8jzW4aj", "type": "rectangle", "x": 1800, "y": 930, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fef9c3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0080", "roundness": {"type": 3}, "seed": 820042334, "version": 1, "versionNonce": 1644334855, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false}, {"id": "tr7mUEmJC4eHYkryhvCR", "type": "text", "x": 1830, "y": 931, "width": 64.35000000000001, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0081", "roundness": null, "seed": 555661297, "version": 1, "versionNonce": 1999656683, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false, "text": "warm pool", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "warm pool", "autoResize": true, "lineHeight": 1.25}, {"id": "ZuaZAQvMdZqBrWT3o7L5", "type": "text", "x": 420, "y": 980, "width": 1393.7, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "IJcWGxMlUkoLZ7k06nxw", "index": "a0082", "roundness": null, "seed": 1172151286, "version": 1, "versionNonce": 2098879876, "isDeleted": false, "boundElements": [], "updated": 1790457285618, "created": 1790457285618, "link": null, "locked": false, "text": "Numbers to say out loud\nPer replica: batch N \u00f7 batch time. Fixed-batch contract 100 per 100 ms \u2192 1,000 req/s per GPU \u2192 10 GPUs floor at 10k RPS; run at ~65% + spares \u2192 ~18.\nBudget 500 ms P95: \u226450 ms in the batcher + 100 ms on the GPU + tens of ms network, keep ~200 ms for one retry. At 100 RPS a 50 ms window holds five requests: the timer is the lever.\nWeights \u2248 1 TB per frontier model, loaded into GPU memory: serving is memory-bound, a model needs a minimum GPU count, and unused weights pinned in memory block another model.\nEight GPUs, two models: reserve all eight atomically for the big one, drain small batches, age so neither starves, say the idle cost.", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Numbers to say out loud\nPer replica: batch N \u00f7 batch time. Fixed-batch contract 100 per 100 ms \u2192 1,000 req/s per GPU \u2192 10 GPUs floor at 10k RPS; run at ~65% + spares \u2192 ~18.\nBudget 500 ms P95: \u226450 ms in the batcher + 100 ms on the GPU + tens of ms network, keep ~200 ms for one retry. At 100 RPS a 50 ms window holds five requests: the timer is the lever.\nWeights \u2248 1 TB per frontier model, loaded into GPU memory: serving is memory-bound, a model needs a minimum GPU count, and unused weights pinned in memory block another model.\nEight GPUs, two models: reserve all eight atomically for the big one, drain small batches, age so neither starves, say the idle cost.", "autoResize": true, "lineHeight": 1.25}, {"id": "l9c16hTrF2ExuH3QDViX", "type": "text", "x": -760, "y": -60, "width": 485.1, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0083", "roundness": null, "seed": 1195962320, "version": 1, "versionNonce": 569138677, "isDeleted": false, "boundElements": [], "updated": 1790457079551, "created": 1790457079551, "link": null, "locked": false, "text": "Requirements (what the user can do)\nSend a prompt and get tokens back, streaming or in one response\nChoose a model and a version, including older versions\nPaid and free tiers, paid served first\nOne API surface across all models and replicas", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Requirements (what the user can do)\nSend a prompt and get tokens back, streaming or in one response\nChoose a model and a version, including older versions\nPaid and free tiers, paid served first\nOne API surface across all models and replicas", "autoResize": true, "lineHeight": 1.25}, {"id": "G0VbL86zWJ90vM947QV0", "type": "text", "x": -760, "y": 55.5, "width": 569.8000000000001, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0084", "roundness": null, "seed": 1551636961, "version": 1, "versionNonce": 781889195, "isDeleted": false, "boundElements": [], "updated": 1790457079551, "created": 1790457079551, "link": null, "locked": false, "text": "Technical challenges (not 'non-functional')\nKeep GPUs near 100% busy: batch at the replica, size-or-time\nBounded tail latency: P95 500 ms, finished sequences leave the batch early\nCold start for inactive models and versions; minimum GPUs per model\nIsolation: one tenant's huge request must not stall the others\nAvailability over consistency; metrics on queue depth, fill, TTFT, P99", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Technical challenges (not 'non-functional')\nKeep GPUs near 100% busy: batch at the replica, size-or-time\nBounded tail latency: P95 500 ms, finished sequences leave the batch early\nCold start for inactive models and versions; minimum GPUs per model\nIsolation: one tenant's huge request must not stall the others\nAvailability over consistency; metrics on queue depth, fill, TTFT, P99", "autoResize": true, "lineHeight": 1.25}, {"id": "GoklkWUMwUCAsRVEzxRW", "type": "text", "x": -760, "y": 188.5, "width": 693.0, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0085", "roundness": null, "seed": 1438031355, "version": 1, "versionNonce": 2033109964, "isDeleted": false, "boundElements": [], "updated": 1790457079551, "created": 1790457079551, "link": null, "locked": false, "text": "Core entities\nRequest(id, tenant_id, model, version, prompt, max_tokens, stream, idempotency_key, state)\nModel(name); ModelVersion(model, version, min_gpus, weights_ref, state: active|inactive)\nReplica(id, model_version, gpu_ids, state: warming|ready|draining, queue)\nTenant/Limit(tenant_id, tier, rpm, tpm)\nBatch is a property of the replica's queue, not an entity", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Core entities\nRequest(id, tenant_id, model, version, prompt, max_tokens, stream, idempotency_key, state)\nModel(name); ModelVersion(model, version, min_gpus, weights_ref, state: active|inactive)\nReplica(id, model_version, gpu_ids, state: warming|ready|draining, queue)\nTenant/Limit(tenant_id, tier, rpm, tpm)\nBatch is a property of the replica's queue, not an entity", "autoResize": true, "lineHeight": 1.25}, {"id": "LZLCJRWorFyx8kC5HInK", "type": "text", "x": -760, "y": 321.5, "width": 785.4000000000001, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0086", "roundness": null, "seed": 1105175912, "version": 1, "versionNonce": 1037514232, "isDeleted": false, "boundElements": [], "updated": 1790457079551, "created": 1790457079551, "link": null, "locked": false, "text": "API\nPOST /v1/messages {model, version?, prompt, max_tokens, stream} \u2192 200 or SSE stream; 429 + retry_after\nGET  /v1/requests/{id} \u2192 state, tokens so far\nGET  /v1/models \u2192 versions, state, warm replicas\nPOST /internal/replicas/{id}/drain \u00b7 /warm \u00b7 /load {model_version}", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "API\nPOST /v1/messages {model, version?, prompt, max_tokens, stream} \u2192 200 or SSE stream; 429 + retry_after\nGET  /v1/requests/{id} \u2192 state, tokens so far\nGET  /v1/models \u2192 versions, state, warm replicas\nPOST /internal/replicas/{id}/drain \u00b7 /warm \u00b7 /load {model_version}", "autoResize": true, "lineHeight": 1.25}, {"id": "gla2fJylnV6WK0loET1y", "type": "text", "x": -760, "y": 437.0, "width": 677.6, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0087", "roundness": null, "seed": 1403747371, "version": 1, "versionNonce": 2103705182, "isDeleted": false, "boundElements": [], "updated": 1790457079551, "created": 1790457079551, "link": null, "locked": false, "text": "Data flow\nauth + tenant limit \u2192 router picks pool by model+version (cold start if none) \u2192\nper-tenant queue \u2192 per-replica batcher (N or 50 ms) \u2192 replica runs prefill then decode \u2192\nfinished sequences return early \u2192 tokens streamed \u2192 metrics emitted", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Data flow\nauth + tenant limit \u2192 router picks pool by model+version (cold start if none) \u2192\nper-tenant queue \u2192 per-replica batcher (N or 50 ms) \u2192 replica runs prefill then decode \u2192\nfinished sequences return early \u2192 tokens streamed \u2192 metrics emitted", "autoResize": true, "lineHeight": 1.25}, {"id": "iO53KJOOIM1yLNj3t7Z1", "type": "text", "x": -760, "y": 535.0, "width": 654.5, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0088", "roundness": null, "seed": 471625561, "version": 1, "versionNonce": 49001392, "isDeleted": false, "boundElements": [], "updated": 1790457079551, "created": 1790457079551, "link": null, "locked": false, "text": "Deep dives to offer\nbatcher constants from the budget \u00b7 capacity maths \u00b7 cold start and warm pool \u00b7\nisolation / noisy neighbour \u00b7 a replica dies mid-batch \u00b7 8-GPU two-model scheduling \u00b7\nKV cache and prefix cache: only if the hit rate pays", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Deep dives to offer\nbatcher constants from the budget \u00b7 capacity maths \u00b7 cold start and warm pool \u00b7\nisolation / noisy neighbour \u00b7 a replica dies mid-batch \u00b7 8-GPU two-model scheduling \u00b7\nKV cache and prefix cache: only if the hit rate pays", "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}