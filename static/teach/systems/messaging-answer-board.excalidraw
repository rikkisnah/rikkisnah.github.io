": "arrow", "x": 570.0, "y": 680, "width": 1, "height": 336, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "T2IOB9h1ZgZNYnUfdBvr", "index": "a0055", "roundness": null, "seed": 1499303801, "version": 1, "versionNonce": 1832832641, "isDeleted": false, "boundElements": [], "updated": 1790734568256, "created": 1790734568256, "link": null, "locked": false, "points": [[0, 0], [0.0, -336]], "startBinding": {"elementId": "HJCkcuJzicZNM90WKzdI", "mode": "orbit", "fixedPoint": [0.5, 0]}, "endBinding": {"elementId": "DfykRv3Pk02xGlvJlMZi", "mode": "orbit", "fixedPoint": [0.5, 1]}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "l0msIXJVJ08lkz8ZaBni", "type": "text", "x": 582.0, "y": 384, "width": 171.60000000000002, "height": 16.25, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "T2IOB9h1ZgZNYnUfdBvr", "index": "a0056", "roundness": null, "seed": 889197102, "version": 1, "versionNonce": 1043632142, "isDeleted": false, "boundElements": [], "updated": 1790734568256, "created": 1790734568256, "link": null, "locked": false, "text": "reconnect: since last id", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "reconnect: since last id", "autoResize": true, "lineHeight": 1.25}, {"id": "qQREmlPtef4AKXSePEfX", "type": "text", "x": 420, "y": 820, "width": 1640.1000000000001, "height": 35.0, "angle": 0, "strokeColor": "#b91c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "T2IOB9h1ZgZNYnUfdBvr", "index": "a0057", "roundness": null, "seed": 290317571, "version": 1, "versionNonce": 168209883, "isDeleted": false, "boundElements": [], "updated": 1790734568256, "created": 1790734568256, "link": null, "locked": false, "text": "Failure / probes: gateway dies \u2192 its ring slice reconnects elsewhere, inboxes replay. Bus drops a publish \u2192 inbox row still there, delivered on reconnect. Push provider down \u2192 inbox holds until the socket returns.\nOrdering: server id per conversation for storage; render by sender_ts, clamp to server_ts \u00b1 window, mark late arrivals; dedupe retransmits on client_msg_id. Global order is the trap.", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Failure / probes: gateway dies \u2192 its ring slice reconnects elsewhere, inboxes replay. Bus drops a publish \u2192 inbox row still there, delivered on reconnect. Push provider down \u2192 inbox holds until the socket returns.\nOrdering: server id per conversation for storage; render by sender_ts, clamp to server_ts \u00b1 window, mark late arrivals; dedupe retransmits on client_msg_id. Global order is the trap.", "autoResize": true, "lineHeight": 1.25}, {"id": "RTez0r8PonD0rPdqkxxQ", "type": "text", "x": 420, "y": 885, "width": 2279.2000000000003, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "T2IOB9h1ZgZNYnUfdBvr", "index": "a0058", "roundness": null, "seed": 658083806, "version": 1, "versionNonce": 850098327, "isDeleted": false, "boundElements": [], "updated": 1790734568256, "created": 1790734568256, "link": null, "locked": false, "text": "Numbers to say: 1B msgs/day \u2192 11.5k/s avg, 35k/s peak \u00b7 10M sockets \u2248 10 gateways \u00b7 200 GB/day \u00b7 delivery < 1 s p99 \u00b7 presence TTL 2\u00d7 a 10\u201330 s heartbeat; last_seen per heartbeat would be 20M writes/s \u00b7 Redis Pub/Sub single-digit ms; Kafka topic-per-user \u2248 50 KB metadata each, 50 TB at 1B users.", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Numbers to say: 1B msgs/day \u2192 11.5k/s avg, 35k/s peak \u00b7 10M sockets \u2248 10 gateways \u00b7 200 GB/day \u00b7 delivery < 1 s p99 \u00b7 presence TTL 2\u00d7 a 10\u201330 s heartbeat; last_seen per heartbeat would be 20M writes/s \u00b7 Redis Pub/Sub single-digit ms; Kafka topic-per-user \u2248 50 KB metadata each, 50 TB at 1B users.", "autoResize": true, "lineHeight": 1.25}, {"id": "xkXK6wpeRpDHA8ZcIX6q", "type": "text", "x": 420, "y": 935, "width": 1701.7, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "T2IOB9h1ZgZNYnUfdBvr", "index": "a0059", "roundness": null, "seed": 1789626871, "version": 1, "versionNonce": 130956998, "isDeleted": false, "boundElements": [], "updated": 1790734568256, "created": 1790734568256, "link": null, "locked": false, "text": "Multi-device: inbox and receipts keyed by device; delivered = any device has it, read = any device opened it (say the product choice). Group: write once, inbox N times, workers above ~100 members, read receipts as counts.", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Multi-device: inbox and receipts keyed by device; delivered = any device has it, read = any device opened it (say the product choice). Group: write once, inbox N times, workers above ~100 members, read receipts as counts.", "autoResize": true, "lineHeight": 1.25}, {"id": "iQtobm8xcZS872XTCGtR", "type": "text", "x": 420, "y": 985, "width": 52.800000000000004, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strok