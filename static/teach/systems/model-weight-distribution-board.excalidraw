oupIds": [], "frameId": null, "index": "a0049", "roundness": {"type": 3}, "seed": 1092441473, "version": 1, "versionNonce": 608429483, "isDeleted": false, "boundElements": [], "updated": 1790436097946, "created": 1790436097946, "link": null, "locked": false}, {"id": "NIDfvVRUMFb5u10ESShL", "type": "text", "x": 1140, "y": 831, "width": 193.05, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0050", "roundness": null, "seed": 514095705, "version": 1, "versionNonce": 1825331254, "isDeleted": false, "boundElements": [], "updated": 1790436097946, "created": 1790436097946, "link": null, "locked": false, "text": "verification, observability", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "verification, observability", "autoResize": true, "lineHeight": 1.25}, {"id": "8pPgzQsQbwAFT1PWzKr0", "type": "rectangle", "x": 1340, "y": 830, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0051", "roundness": {"type": 3}, "seed": 442020370, "version": 1, "versionNonce": 1849544494, "isDeleted": false, "boundElements": [], "updated": 1790436097946, "created": 1790436097946, "link": null, "locked": false}, {"id": "3Ju2l3rxLq21xIJx5kjM", "type": "text", "x": 1370, "y": 831, "width": 85.80000000000001, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0052", "roundness": null, "seed": 988599619, "version": 1, "versionNonce": 1136991867, "isDeleted": false, "boundElements": [], "updated": 1790436097946, "created": 1790436097946, "link": null, "locked": false, "text": "serving gate", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "serving gate", "autoResize": true, "lineHeight": 1.25}, {"id": "gpFbqCPxa6nxIS7OVMVZ", "type": "text", "x": 420, "y": 880, "width": 1262.8000000000002, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0053", "roundness": null, "seed": 122506375, "version": 1, "versionNonce": 3050131, "isDeleted": false, "boundElements": [], "updated": 1790436097946, "created": 1790436097946, "link": null, "locked": false, "text": "Numbers to say out loud, in the first five minutes\nLower bound: each host must receive 500 GB over a 10 Gbps NIC \u2192 500 \u00d7 8 / 10 = 400 s. Nothing beats that. (800 s if up and down share the link.)\nNaive pull from the source: 1,000 \u00d7 400 s. Tree broadcast: better but each level waits for the whole file. Chunked swarm: bandwidth adds up, completion \u2192 the bound.\nCap concurrent peers per host (incast); rack-aware peer choice if there is topology; bandwidth caps so production traffic survives.", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Numbers to say out loud, in the first five minutes\nLower bound: each host must receive 500 GB over a 10 Gbps NIC \u2192 500 \u00d7 8 / 10 = 400 s. Nothing beats that. (800 s if up and down share the link.)\nNaive pull from the source: 1,000 \u00d7 400 s. Tree broadcast: better but each level waits for the whole file. Chunked swarm: bandwidth adds up, completion \u2192 the bound.\nCap concurrent peers per host (incast); rack-aware peer choice if there is topology; bandwidth caps so production traffic survives.", "autoResize": true, "lineHeight": 1.25}, {"id": "dHUFXhMD0oCxRn61R1j7", "type": "text", "x": -760, "y": -60, "width": 408.1, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0054", "roundness": null, "seed": 963218114, "version": 1, "versionNonce": 1777123519, "isDeleted": false, "boundElements": [], "updated": 1790436097946, "created": 1790436097946, "link": null, "locked": false, "text": "Functional requirements\nDistribute one model version to a target set of hosts\nEvery host ends with a complete, verified copy\nResume after interruption without restarting\nOperators see progress and can cap bandwidth", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Functional requirements\nDistribute one model version to a target set of hosts\nEvery host ends with a complete, verified copy\nResume after interruption without restarting\nOperators see progress and can cap bandwidth", "autoResize": true, "lineHeight": 1.25}, {"id": "8bX5f3atblkIA7UeerYX", "type": "text", "x": -760, "y": 67.5, "width": 454.3, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0055", "roundness": null, "seed": 69359286, "version": 1, "versionNonce": 1459739764, "isDeleted": false, "boundElements": [], "updated": 1790436097946, "created": 1790436097946, "link": null, "locked": false, "text": "Non-functional\nMinimise completion time toward the link bound\n1\u20135% of hosts fail during a rollout; finish without a human\nNever serve from a partial or wrong-version copy\nNew version every few hours; keep the previous for rollback", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Non-functional\nMinimise completion time toward the link bound\n1\u20135% of hosts fail during a rollout; finish without a human\nNever serve from a partial or wrong-version copy\nNew version every few hours; keep the previous for rollback", "autoResize": true, "lineHeight": 1.25}, {"id": "TI0ZY2GfMR6U34u5JABE", "type": "text", "x": -760, "y": 195.0, "width": 338.8, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0056", "roundness": null, "seed": 1779497933, "version": 1, "versionNonce": 1101061945, "isDeleted": false, "boundElements": [], "updated": 1790436097946, "created": 1790436097946, "link": null, "locked": false, "text": "Clarify first\n10 Gbps or 10 GB/s? Per direction or shared?\nAny topology (racks, spines) or assume none?\nHow many hosts today, and next year?", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Clarify first\n10 Gbps or 10 GB/s? Per direction or shared?\nAny topology (racks, spines) or assume none?\nHow many hosts today, and next year?", "autoResize": true, "lineHeight": 1.25}, {"id": "qjHANuGdPEqhDf2DQugA", "type": "text", "x": -760, "y": 305.0, "width": 508.20000000000005, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0057", "roundness": null, "seed": 916425138, "version": 1, "versionNonce": 352610841, "isDeleted": false, "boundElements": [], "updated": 1790436097946, "created": 1790436097946, "link": null, "locked": false, "text": "What breaks first\nEvery host pulls from the source \u2192 source link saturated for hours\nNo chunking \u2192 one failure restarts 500 GB\nAll downloads at once \u2192 incast, NIC oversubscription\nNo readiness gate \u2192 half-loaded hosts take traffic", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What breaks first\nEvery host pulls from the source \u2192 source link saturated for hours\nNo chunking \u2192 one failure restarts 500 GB\nAll downloads at once \u2192 incast, NIC oversubscription\nNo readiness gate \u2192 half-loaded hosts take traffic", "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}