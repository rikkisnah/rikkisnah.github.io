ery pointer", "autoResize": true, "lineHeight": 1.25}, {"id": "dMWuc1wy3jOwLBm6GlCL", "type": "arrow", "x": 1700, "y": 620.0, "width": 160, "height": 15.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0050", "roundness": null, "seed": 341017818, "version": 1, "versionNonce": 1295187979, "isDeleted": false, "boundElements": [], "updated": 1791050845017, "created": 1791050845017, "link": null, "locked": false, "points": [[0, 0], [-160, -15.0]], "startBinding": {"elementId": "986oEmrhGtJhAy62ZGPr", "mode": "orbit", "fixedPoint": [0, 0.5]}, "endBinding": {"elementId": "9xmfMq3nAxfxBo1dCFMe", "mode": "orbit", "fixedPoint": [1, 0.5]}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "vAeKKmzBKcd1ljQKx9sT", "type": "text", "x": 1560, "y": 628.0, "width": 50.050000000000004, "height": 16.25, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0051", "roundness": null, "seed": 153481754, "version": 1, "versionNonce": 1106599269, "isDeleted": false, "boundElements": [], "updated": 1791050845017, "created": 1791050845017, "link": null, "locked": false, "text": "compare", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "compare", "autoResize": true, "lineHeight": 1.25}, {"id": "w03F9rtm2c6PWTNlnMRb", "type": "text", "x": 420, "y": 760, "width": 957.0000000000001, "height": 150.0, "angle": 0, "strokeColor": "#b23a28", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0052", "roundness": null, "seed": 906209343, "version": 1, "versionNonce": 1959003310, "isDeleted": false, "boundElements": [], "updated": 1791050845017, "created": 1791050845017, "link": null, "locked": false, "text": "RED: the curveballs and what to say\nRetry after a lost ack: same event_id; dedupe in the processor drops the copy. A queue alone is not exactly-once.\nRenamed metric: ASK how they differ. Merge only if owners confirm same boundaries; unit from the client contract.\n  Scope the alias by tenant, app, client version. Incoming: resolve at ingest, keep the raw name. History: read-time\n  alias now, rebuild from raw (30 d) into g+1, shadow-compare, cut over. Mean = sum/count; p99 only from sketches.\nBad mapping: publish v n+1, record offset T per partition; rebuild offsets < T from raw into g+1, live writes >= T\n  into g+1; each event lands on one side, upserts idempotent on event_id. Validate, flip, keep g for rollback.\nNotice corruption: a step change in the canonical series at the mapping's start time; shadow queries before cutover.", "fontSize": 15, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "RED: the curveballs and what to say\nRetry after a lost ack: same event_id; dedupe in the processor drops the copy. A queue alone is not exactly-once.\nRenamed metric: ASK how they differ. Merge only if owners confirm same boundaries; unit from the client contract.\n  Scope the alias by tenant, app, client version. Incoming: resolve at ingest, keep the raw name. History: read-time\n  alias now, rebuild from raw (30 d) into g+1, shadow-compare, cut over. Mean = sum/count; p99 only from sketches.\nBad mapping: publish v n+1, record offset T per partition; rebuild offsets < T from raw into g+1, live writes >= T\n  into g+1; each event lands on one side, upserts idempotent on event_id. Validate, flip, keep g for rollback.\nNotice corruption: a step change in the canonical series at the mapping's start time; shadow queries before cutover.", "autoResize": true, "lineHeight": 1.25}, {"id": "G3nkG0KJ5G7znFaTGNZS", "type": "text", "x": 420, "y": 980, "width": 52.800000000000004, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0053", "roundness": null, "seed": 1753785414, "version": 1, "versionNonce": 1740979151, "isDeleted": false, "boundElements": [], "updated": 1791050845017, "created": 1791050845017, "link": null, "locked": false, "text": "Legend", "fontSize": 16, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Legend", "autoResize": true, "lineHeight": 1.25}, {"id": "NZSQKV0OD8baznpdTat8", "type": "rectangle", "x": 420, "y": 1010, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#f3f4f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0054", "roundness": {"type": 3}, "seed": 182485178, "version": 1, "versionNonce": 552510766, "isDeleted": false, "boundElements": [], "updated": 1791050845017, "created": 1791050845017, "link": null, "locked": false}, {"id": "NnorXr6Jhn9EJgXxbitf", "type": "text", "x": 450, "y": 1011, "width": 128.70000000000002, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0055", "roundness": null, "seed": 1312693121, "version": 1, "versionNonce": 964892276, "isDeleted": false, "boundElements": [], "updated": 1791050845017, "created": 1791050845017, "link": null, "locked": false, "text": "clients, dashboard", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "orig