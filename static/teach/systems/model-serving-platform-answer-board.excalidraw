, "textAlign": "center", "verticalAlign": "middle", "containerId": "HeOA0PK9A13h4AlU3EF6", "originalText": "Artifact store (object storage)\nweights + checksum, immutable\nmirrored per region", "autoResize": true, "lineHeight": 1.25}, {"id": "IuupTaLPBAWFdS881cIl", "type": "rectangle", "x": 420, "y": 240, "width": 300, "height": 84, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#f3f4f6", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "Cx2kUhpYP9Rqn51OJeD9", "index": "a0015", "roundness": {"type": 3}, "seed": 549220766, "version": 1, "versionNonce": 556320078, "isDeleted": false, "boundElements": [{"type": "text", "id": "F3lU8BEf4jUSq85MzEBO"}, {"type": "arrow", "id": "3EGU5ejesBwLgg3JKEXU"}], "updated": 1790573240449, "created": 1790573240449, "link": null, "locked": false}, {"id": "F3lU8BEf4jUSq85MzEBO", "type": "text", "x": 430, "y": 264.5, "width": 280, "height": 35.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "Cx2kUhpYP9Rqn51OJeD9", "index": "a0016", "roundness": null, "seed": 886808048, "version": 1, "versionNonce": 410683237, "isDeleted": false, "boundElements": [], "updated": 1790573240449, "created": 1790573240449, "link": null, "locked": false, "text": "Clients around the globe\napps, services", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "center", "verticalAlign": "middle", "containerId": "IuupTaLPBAWFdS881cIl", "originalText": "Clients around the globe\napps, services", "autoResize": true, "lineHeight": 1.25}, {"id": "sTWidggCIDyzPeCqYSRZ", "type": "rectangle", "x": 940, "y": 240, "width": 300, "height": 110, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffedd5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId"