oughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0044", "roundness": null, "seed": 1033817644, "version": 1, "versionNonce": 107874913, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "heartbeat 10\u201330 s refreshes TTL \u00b7 expiry = offline", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "heartbeat 10\u201330 s refreshes TTL \u00b7 expiry = offline", "autoResize": true, "lineHeight": 1.25}, {"id": "RKOocbvB7TaOIZjZEO7v", "type": "text", "x": 900, "y": 600, "width": 1186.9, "height": 32.5, "angle": 0, "strokeColor": "#b91c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0045", "roundness": null, "seed": 217393118, "version": 1, "versionNonce": 527810987, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "Offline: B is offline at step 5 \u2192 nothing subscribes, the message is safe in the Inbox. On reconnect B reads Inbox, fetches bodies from Messages, ACKs \u2192 rows deleted.\nSo the bus may be at-most-once.  Second device: scope Inbox by (recipient, client_id); cap devices per account.", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Offline: B is offline at step 5 \u2192 nothing subscribes, the message is safe in the Inbox. On reconnect B reads Inbox, fetches bodies from Messages, ACKs \u2192 rows deleted.\nSo the bus may be at-most-once.  Second device: scope Inbox by (recipient, client_id); cap devices per account.", "autoResize": true, "lineHeight": 1.25}, {"id": "BXXMwsCuFOf5i2aa7uyV", "type": "text", "x": 420, "y": 700, "width": 52.800000000000004, "height": 2