2, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#dbeafe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0049", "roundness": {"type": 3}, "seed": 103578530, "version": 1, "versionNonce": 126773419, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false}, {"id": "1BPFGxW29JCJ7uaF1ivM", "type": "text", "x": 680, "y": 731, "width": 71.5, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0050", "roundness": null, "seed": 66609604, "version": 1, "versionNonce": 1423439462, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "front door", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "front door", "autoResize": true, "lineHeight": 1.25}, {"id": "7jmIcOKJYrNyd4DDvEmM", "type": "rectangle", "x": 880, "y": 730, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffedd5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0051", "roundness": {"type": 3}, "seed": 1459590220, "version": 1, "versionNonce": 1335274560, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false}, {"id": "IE7W6h4KEA0zrZ2yetvi", "type": "text", "x": 910, "y": 731, "width": 157.3, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0052", "roundness": null, "seed": 91110529, "version": 1, "versionNonce": 2137153486, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "gateways (the service)", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "gateways (the service)", "autoResize": true, "lineHeight": 1.25}, {"id": "xOOMaUibUAmixOcGC2Ak", "type": "rectangle", "x": 1110, "y": 730, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#dcfce7", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0053", "roundness": {"type": 3}, "seed": 388942759, "version": 1, "versionNonce": 410576071, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false}, {"id": "XBEEyIuCPAEiZy17Wvn2", "type": "text", "x": 1140, "y": 731, "width": 50.050000000000004, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0054", "roundness": null, "seed": 529176889, "version": 1, "versionNonce": 961246533, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "storage", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "storage", "autoResize": true, "lineHeight": 1.25}, {"id": "C1Sua4BtanTLjVWfMuxr", "type": "rectangle", "x": 1340, "y": 730, "width": 22, "height": 22, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ede9fe", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0055", "roundness": {"type": 3}, "seed": 383823668, "version": 1, "versionNonce": 880739145, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false}, {"id": "7j9bzq9v9xhxeEkniu9H", "type": "text", "x": 1370, "y": 731, "width": 121.55000000000001, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0056", "roundness": null, "seed": 1731989941, "version": 1, "versionNonce": 1844901628, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "coordination, bus", "fontSize": 13, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "coordination, bus", "autoResize": true, "lineHeight": 1.25}, {"id": "00OUzOdfZhg1V4wjc3EN", "type": "text", "x": 420, "y": 780, "width": 1085.7, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0057", "roundness": null, "seed": 1193088195, "version": 1, "versionNonce": 2090885444, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "Numbers to say out loud\n100 M DAU \u00d7 10 messages = 1 B/day \u2248 11.6 k/s average, \u00d73 peak \u2248 35 k/s.  10 M concurrent sockets \u00f7 ~1 M per gateway \u2248 10 gateways.\n200 B/message \u2192 200 GB/day, ~73 TB/year.  Delivery < 500 ms, 99.9%.  Ordering per conversation via server-issued monotonic ids, never global.\nWhy not Kafka for fan-out: ~50 KB metadata per topic \u2192 topic-per-user is impossible; use Kafka only if hours of replay is a hard requirement.", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Numbers to say out loud\n100 M DAU \u00d7 10 messages = 1 B/day \u2248 11.6 k/s average, \u00d73 peak \u2248 35 k/s.  10 M concurrent sockets \u00f7 ~1 M per gateway \u2248 10 gateways.\n200 B/message \u2192 200 GB/day, ~73 TB/year.  Delivery < 500 ms, 99.9%.  Ordering per conversation via server-issued monotonic ids, never global.\nWhy not Kafka for fan-out: ~50 KB metadata per topic \u2192 topic-per-user is impossible; use Kafka only if hours of replay is a hard requirement.", "autoResize": true, "lineHeight": 1.25}, {"id": "qBzh7Z0ydZNPL4d5f2q8", "type": "text", "x": -760, "y": -60, "width": 477.40000000000003, "height": 70.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0058", "roundness": null, "seed": 1034024470, "version": 1, "versionNonce": 2094764935, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "The prompt gives three things\none-to-one \u00b7 text only \u00b7 web app only\nAsk for everything else: load, latency, delivery guarantee,\nordering, offline behaviour, retention, single or multi device", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The prompt gives three things\none-to-one \u00b7 text only \u00b7 web app only\nAsk for everything else: load, latency, delivery guarantee,\nordering, offline behaviour, retention, single or multi device", "autoResize": true, "lineHeight": 1.25}, {"id": "ZRp3VqHageYBL4riq6uc", "type": "text", "x": -760, "y": 50.0, "width": 546.7, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0059", "roundness": null, "seed": 297910867, "version": 1, "versionNonce": 1634106990, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "Functional requirements\nA can send B a text message; delivered in near real time if B is online\nOffline messages are stored and delivered on next login\nDelivery acknowledgement so nothing is lost\nPer-conversation history and pagination", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Functional requirements\nA can send B a text message; delivered in near real time if B is online\nOffline messages are stored and delivered on next login\nDelivery acknowledgement so nothing is lost\nPer-conversation history and pagination", "autoResize": true, "lineHeight": 1.25}, {"id": "ePeVeShFJnqYfObml8ed", "type": "text", "x": -760, "y": 177.5, "width": 539.0, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0060", "roundness": null, "seed": 1391240150, "version": 1, "versionNonce": 522916600, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "Non-functional\nNo single box takes the system down\nMilliseconds to seconds to an online user\nScale horizontally with users, sockets and volume\nExactly-once from the client's point of view (dedupe on client_msg_id)", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Non-functional\nNo single box takes the system down\nMilliseconds to seconds to an online user\nScale horizontally with users, sockets and volume\nExactly-once from the client's point of view (dedupe on client_msg_id)", "autoResize": true, "lineHeight": 1.25}, {"id": "DcNFNO6dNHGqaVRf22mC", "type": "text", "x": -760, "y": 305.0, "width": 415.8, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0061", "roundness": null, "seed": 798029989, "version": 1, "versionNonce": 399899958, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "Data model\nusers(id, last_seen)\nconversations(id, user_a, user_b, last_message_id)\nmessages(conversation_id, id, sender, body, server_ts)\ninbox(recipient_id, client_id, message_id, ttl)", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Data model\nusers(id, last_seen)\nconversations(id, user_a, user_b, last_message_id)\nmessages(conversation_id, id, sender, body, server_ts)\ninbox(recipient_id, client_id, message_id, ttl)", "autoResize": true, "lineHeight": 1.25}, {"id": "f6TX3XSOewiWIwSGDu3j", "type": "text", "x": -760, "y": 432.5, "width": 562.1, "height": 87.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0062", "roundness": null, "seed": 79289989, "version": 1, "versionNonce": 2045487773, "isDeleted": false, "boundElements": [], "updated": 1790436594104, "created": 1790436594104, "link": null, "locked": false, "text": "What breaks first\nRandom gateway per connection \u2192 cannot find B \u2192 broadcast to all gateways\nlast_seen written per heartbeat \u2192 20 M writes/s\nGlobal ordering promised \u2192 a trap; per conversation is enough\nOne hot partition for all messages \u2192 tail latency", "fontSize": 14, "baseFontSize": null, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What breaks first\nRandom gateway per connection \u2192 cannot find B \u2192 broadcast to all gateways\nlast_seen written per heartbeat \u2192 20 M writes/s\nGlobal ordering promised \u2192 a trap; per conversation is enough\nOne hot partition for all messages \u2192 tail latency", "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}