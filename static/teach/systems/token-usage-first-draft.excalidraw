    {
      "id": "ngCYj7V4f4F3jFbZeemyB",
      "type": "text",
      "x": -1239.2488098144531,
      "y": 62.890625,
      "width": 999.6591796875,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
